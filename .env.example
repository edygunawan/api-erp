APP_NAME=rest-api
APP_ENV=local
DEBUG_MODE=false
HTTP_PORT=8080

# mysql or postgres. Leave DB_PORT empty to select 3306 or 5432 automatically.
DB_DRIVER=mysql
DB_AUTH_MODE=password
DB_HOST=127.0.0.1
DB_PORT=
DB_NAME=rest_api
DB_USER=rest_api
DB_PASSWORD=
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_SECONDS=180

# TLS options apply only to the selected driver.
POSTGRES_SSL_MODE=disable
MYSQL_TLS_MODE=disable
# Optional CA bundle for verified TLS.
DB_TLS_CA_FILE=

# API, migration and bootstrap share the connection factory.
# Non-password authentication requires an injected CredentialsProvider.
# Explicit migrations are the default. Set true only when startup should migrate.
AUTO_MIGRATE=false

JWT_SECRET=
JWT_ISSUER=go-rest-api
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_MINUTES=10080

CORS_ALLOWED_ORIGINS=
SENTRY_DSN=

ADMIN_FULL_NAME=
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
